FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# Fleet state and the published version live in SQLite, not Firestore - defaults to data/karika.db
# relative to the working directory if unset.
LOCAL_DB_PATH=./data/karika.db

# Login (defaults to admin/admin if unset - change these before this is anything but a
# throwaway internal tool)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Random hex string - keeps people logged in across restarts/deploys. Generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
