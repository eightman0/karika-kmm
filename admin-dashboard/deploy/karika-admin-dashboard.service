[Unit]
Description=Karika Kiosk Admin Dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/karika-admin-dashboard
EnvironmentFile=/etc/karika-admin-dashboard/env
ExecStart=/opt/karika-admin-dashboard/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
User=www-data

[Install]
WantedBy=multi-user.target
