# Reference only - not applied automatically. Place on the VPS at
# /etc/nginx/sites-available/karika.car4hire.ba, symlink into sites-enabled, then run
# `sudo certbot --nginx -d karika.car4hire.ba` (it rewrites this file in place to add the
# HTTPS server block + HTTP->HTTPS redirect and sets up auto-renewal).
#
# No auth in front of this on purpose (for now) - the dashboard itself has none either, so
# anyone with the URL has full control of the device fleet (trigger installs, pull device logs
# that may contain customer data). Add `auth_basic`/`auth_basic_user_file` back here (or real
# login in the app) before that's a problem.

server {
    listen 80;
    server_name karika.car4hire.ba;

    # nginx's default is 1MB - the /versions/publish APK upload is way past that.
    client_max_body_size 200M;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
