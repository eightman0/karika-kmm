# Reference only - not applied automatically. Place on the VPS at
# /etc/nginx/sites-available/karika.car4hire.ba, symlink into sites-enabled, then run
# `sudo certbot --nginx -d karika.car4hire.ba` (it rewrites this file in place to add the
# HTTPS server block + HTTP->HTTPS redirect and sets up auto-renewal).
#
# Requires /etc/nginx/.htpasswd-karika to exist first:
#   sudo htpasswd -c /etc/nginx/.htpasswd-karika admin
#
# This dashboard has no login of its own - basic auth here is the only thing standing between
# the internet and full control of the device fleet (trigger installs, pull device logs). Don't
# drop the auth_basic lines even after certbot adds TLS.

server {
    listen 80;
    server_name karika.car4hire.ba;

    location / {
        auth_basic "Karika Admin";
        auth_basic_user_file /etc/nginx/.htpasswd-karika;

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
