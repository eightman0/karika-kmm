<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_k_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_k_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/customers_reps_sheet_title"
            android:textColor="@color/k_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/button_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_k_circle_button"
            android:clickable="true"
            android:contentDescription="@string/customers_sheet_close_cd"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            app:tint="@color/k_ink" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reps_list_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_k_card"
        android:divider="@drawable/bg_k_divider"
        android:orientation="vertical"
        android:showDividers="middle" />

</LinearLayout>
