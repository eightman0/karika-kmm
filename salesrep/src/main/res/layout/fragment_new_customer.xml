<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/karika_gray20"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_marginBottom="0dp"
                android:background="@drawable/bg_info_banner"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info"
                    app:tint="@color/karika_blue" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/new_customer_info_banner"
                    android:textColor="@color/karika_gray2"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Section 1: Informacije o pravnom licu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_order_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_add_option_icon"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_storefront"
                        app:tint="@color/karika_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/new_customer_section_legal"
                        android:textColor="@color/karika_gray2"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_customer_company"
                    android:textColor="@color/karika_gray6"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="5dp" />

                <EditText
                    android:id="@+id/edit_company"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_form_field"
                    android:hint="@string/new_customer_company"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/karika_gray2"
                    android:textColorHint="@color/karika_gray7"
                    android:textSize="14sp" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_customer_id_number"
                            android:textColor="@color/karika_gray6"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="5dp" />

                        <EditText
                            android:id="@+id/edit_id_number"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_form_field"
                            android:hint="@string/new_customer_id_number"
                            android:inputType="number"
                            android:maxLines="1"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="12dp"
                            android:textColor="@color/karika_gray2"
                            android:textColorHint="@color/karika_gray7"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_customer_vat_number"
                            android:textColor="@color/karika_gray6"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="5dp" />

                        <EditText
                            android:id="@+id/edit_vat_number"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_form_field"
                            android:hint="@string/new_customer_vat_number"
                            android:inputType="number"
                            android:maxLines="1"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="12dp"
                            android:textColor="@color/karika_gray2"
                            android:textColorHint="@color/karika_gray7"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_customer_street"
                    android:textColor="@color/karika_gray6"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="5dp" />

                <EditText
                    android:id="@+id/edit_street"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_form_field"
                    android:hint="@string/new_customer_street"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/karika_gray2"
                    android:textColorHint="@color/karika_gray7"
                    android:textSize="14sp" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_customer_postcode"
                            android:textColor="@color/karika_gray6"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="5dp" />

                        <EditText
                            android:id="@+id/edit_postcode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_form_field"
                            android:hint="@string/new_customer_postcode"
                            android:inputType="number"
                            android:maxLines="1"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="12dp"
                            android:textColor="@color/karika_gray2"
                            android:textColorHint="@color/karika_gray7"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_customer_entity"
                            android:textColor="@color/karika_gray6"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="5dp" />

                        <LinearLayout
                            android:id="@+id/picker_entity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_form_field"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/text_entity_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/new_customer_pick_entity"
                                android:textColor="@color/karika_gray7"
                                android:textSize="14sp" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="@color/karika_gray6" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_canton_picker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="16dp" />

                    <TextView
                        android:id="@+id/label_canton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/karika_gray6"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Kanton*" />

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="5dp" />

                    <LinearLayout
                        android:id="@+id/picker_canton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_form_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/text_canton_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/karika_gray7"
                            android:textSize="14sp"
                            tools:text="Odaberite kanton" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/karika_gray6" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_city_picker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/new_customer_city"
                        android:textColor="@color/karika_gray6"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="5dp" />

                    <LinearLayout
                        android:id="@+id/picker_city"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_form_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/text_city_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/new_customer_pick_city"
                            android:textColor="@color/karika_gray7"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/karika_gray6" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_city_readonly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/new_customer_city_label"
                        android:textColor="@color/karika_gray6"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="5dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_form_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/text_city_readonly"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/karika_gray2"
                            android:textSize="14sp"
                            tools:text="Brčko Grad" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_customer_store_size"
                            android:textColor="@color/karika_gray6"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="5dp" />

                        <LinearLayout
                            android:id="@+id/picker_store_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_form_field"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/text_store_size_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/new_customer_store_size_placeholder"
                                android:textColor="@color/karika_gray7"
                                android:textSize="14sp" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="@color/karika_gray6" />
                        </LinearLayout>
                    </LinearLayout>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_customer_store_type"
                            android:textColor="@color/karika_gray6"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="5dp" />

                        <LinearLayout
                            android:id="@+id/picker_store_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_form_field"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/text_store_type_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/new_customer_store_type_placeholder"
                                android:textColor="@color/karika_gray7"
                                android:textSize="14sp" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="@color/karika_gray6" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_customer_employee_count"
                    android:textColor="@color/karika_gray6"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="5dp" />

                <EditText
                    android:id="@+id/edit_employee_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_form_field"
                    android:hint="@string/new_customer_employee_count"
                    android:inputType="number"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/karika_gray2"
                    android:textColorHint="@color/karika_gray7"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Section 2: Kontakt osoba -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_order_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_add_option_icon"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/karika_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/new_customer_section_contact"
                        android:textColor="@color/karika_gray2"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_customer_firstname"
                            android:textColor="@color/karika_gray6"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="5dp" />

                        <EditText
                            android:id="@+id/edit_firstname"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_form_field"
                            android:hint="@string/new_customer_firstname"
                            android:maxLines="1"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="12dp"
                            android:textColor="@color/karika_gray2"
                            android:textColorHint="@color/karika_gray7"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_customer_lastname"
                            android:textColor="@color/karika_gray6"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="5dp" />

                        <EditText
                            android:id="@+id/edit_lastname"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_form_field"
                            android:hint="@string/new_customer_lastname"
                            android:maxLines="1"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="12dp"
                            android:textColor="@color/karika_gray2"
                            android:textColorHint="@color/karika_gray7"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_customer_phone"
                            android:textColor="@color/karika_gray6"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="5dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_form_field"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="12dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_phone"
                                app:tint="@color/karika_gray6" />

                            <EditText
                                android:id="@+id/edit_phone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="@string/new_customer_phone"
                                android:inputType="phone"
                                android:maxLines="1"
                                android:padding="0dp"
                                android:textColor="@color/karika_gray2"
                                android:textColorHint="@color/karika_gray7"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_customer_email"
                            android:textColor="@color/karika_gray6"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="5dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_form_field"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="12dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_email"
                                app:tint="@color/karika_gray6" />

                            <EditText
                                android:id="@+id/edit_email"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="@string/new_customer_email"
                                android:inputType="textEmailAddress"
                                android:maxLines="1"
                                android:padding="0dp"
                                android:textColor="@color/karika_gray2"
                                android:textColorHint="@color/karika_gray7"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/button_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline_blue"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_cancel"
                android:textColor="@color/karika_blue"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/button_save"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_fab_order_customer"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:id="@+id/text_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_customer_save"
                android:textColor="@color/karika_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress_save"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminateTint="@color/karika_white"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
