<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/karika_gray20"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/row_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_back"
                app:tint="@color/karika_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/analytics_filters_back"
                android:textColor="@color/karika_gray2"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/analytics_filters_title"
            android:textColor="@color/karika_gray2"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Period -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_order_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analytics_filters_period"
                android:textColor="@color/karika_gray2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="1dp"
                android:layout_height="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analytics_filters_from"
                        android:textColor="@color/karika_gray6"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="5dp" />

                    <LinearLayout
                        android:id="@+id/field_date_from"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_form_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/karika_gray6" />

                        <TextView
                            android:id="@+id/text_date_from"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textColor="@color/karika_gray2"
                            android:textSize="14sp"
                            tools:text="01.09.2026." />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analytics_filters_to"
                        android:textColor="@color/karika_gray6"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="5dp" />

                    <LinearLayout
                        android:id="@+id/field_date_to"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_form_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/karika_gray6" />

                        <TextView
                            android:id="@+id/text_date_to"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textColor="@color/karika_gray2"
                            android:textSize="14sp"
                            tools:text="29.09.2026." />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Grupisanje / Poređenje -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_order_card"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analytics_filters_grouping"
                    android:textColor="@color/karika_gray6"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="5dp" />

                <LinearLayout
                    android:id="@+id/field_grouping"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_form_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/text_grouping_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/karika_gray2"
                        android:textSize="14sp"
                        tools:text="Dan" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/karika_gray6" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analytics_filters_comparison"
                    android:textColor="@color/karika_gray6"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="5dp" />

                <LinearLayout
                    android:id="@+id/field_comparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_form_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/text_comparison_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/karika_gray2"
                        android:textSize="14sp"
                        tools:text="Prethodni period" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/karika_gray6" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Komercijalista -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_order_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analytics_filters_rep"
                android:textColor="@color/karika_gray2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="1dp"
                android:layout_height="12dp" />

            <EditText
                android:id="@+id/edit_rep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_form_field"
                android:hint="@string/analytics_filters_search_reps"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:textColor="@color/karika_gray2"
                android:textColorHint="@color/karika_gray7"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Kupac -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_order_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analytics_filters_customer"
                android:textColor="@color/karika_gray2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="1dp"
                android:layout_height="12dp" />

            <EditText
                android:id="@+id/edit_customer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_form_field"
                android:hint="@string/analytics_filters_search_customers"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:textColor="@color/karika_gray2"
                android:textColorHint="@color/karika_gray7"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Proizvod -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_order_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analytics_filters_product"
                android:textColor="@color/karika_gray2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="1dp"
                android:layout_height="12dp" />

            <EditText
                android:id="@+id/edit_product"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_form_field"
                android:hint="@string/analytics_filters_search_products"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:textColor="@color/karika_gray2"
                android:textColorHint="@color/karika_gray7"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Kategorija -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_order_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analytics_filters_category"
                android:textColor="@color/karika_gray2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="1dp"
                android:layout_height="12dp" />

            <EditText
                android:id="@+id/edit_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_form_field"
                android:hint="@string/analytics_filters_search_categories"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:textColor="@color/karika_gray2"
                android:textColorHint="@color/karika_gray7"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/button_apply"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_fab_order_customer"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analytics_filters_apply"
                android:textColor="@color/karika_white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
