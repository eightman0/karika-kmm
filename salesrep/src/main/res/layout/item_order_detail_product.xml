<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_k_card_14"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/k_ink"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Naziv proizvoda" />

            <TextView
                android:id="@+id/text_product_qty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/k_muted"
                android:textSize="12sp"
                tools:text="Količina: 5 kom" />
        </LinearLayout>

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/text_product_rabat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_k_pill_accent_soft"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/k_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Rabat 10%" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/k_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_detail_price_vpc"
                android:textColor="@color/k_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/text_price_vpc_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/k_ink"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="12,50 KM" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_detail_total_vpc"
                android:textColor="@color/k_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/text_total_vpc_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/k_ink"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="62,50 KM" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_detail_total_with_pdv"
                android:textColor="@color/k_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/text_total_pdv_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/k_ink"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="73,13 KM" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_commission_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/k_muted"
                android:textSize="11sp"
                tools:text="Provizija (5%)" />

            <TextView
                android:id="@+id/text_commission_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/k_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="3,13 KM" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
