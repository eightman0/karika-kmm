<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/karika_gray20"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_order_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/discount_form_item_label"
                android:textColor="@color/karika_gray6"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="1dp"
                android:layout_height="6dp" />

            <LinearLayout
                android:id="@+id/search_field_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_discount_search_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:id="@+id/icon_item_search"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/karika_gray6" />

                <EditText
                    android:id="@+id/edit_item_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/discount_form_item_hint"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="@color/karika_gray2"
                    android:textColorHint="@color/karika_gray7"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/button_clear_item"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_clear_button_circle"
                    android:contentDescription="@string/action_delete"
                    android:padding="4dp"
                    android:src="@drawable/ic_tertiary"
                    android:visibility="gone"
                    app:tint="@color/karika_gray6" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_search_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_discount_dropdown_results"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <Space
                android:layout_width="1dp"
                android:layout_height="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/discount_form_min_qty"
                        android:textColor="@color/karika_gray6"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="6dp" />

                    <EditText
                        android:id="@+id/edit_min_qty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_form_field"
                        android:hint="@string/discount_form_min_qty_placeholder"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"
                        android:textColor="@color/karika_gray2"
                        android:textColorHint="@color/karika_gray7"
                        android:textSize="14sp" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/discount_form_percent"
                        android:textColor="@color/karika_gray6"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_form_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp">

                        <EditText
                            android:id="@+id/edit_discount_percent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/discount_form_percent_placeholder"
                            android:inputType="number"
                            android:maxLines="1"
                            android:padding="0dp"
                            android:textColor="@color/karika_gray2"
                            android:textColorHint="@color/karika_gray7"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/discount_form_percent_suffix"
                            android:textColor="@color/karika_gray6"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/button_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline_blue"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_cancel"
                android:textColor="@color/karika_blue"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/button_save"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_fab_order_customer"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:id="@+id/text_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/discount_form_save"
                android:textColor="@color/karika_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress_save"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminateTint="@color/karika_white"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
