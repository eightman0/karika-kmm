<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:id="@+id/bubble_column"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.82">

        <TextView
            android:id="@+id/text_sender_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="4dp"
            android:layout_marginHorizontal="4dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:textColor="@color/k_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Ja" />

        <TextView
            android:id="@+id/text_message_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="@drawable/bg_k_msg_bubble_mine"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/k_white"
            android:textSize="14sp"
            tools:text="Vidimo se sutra na sastanku u 10h." />

        <TextView
            android:id="@+id/text_message_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="4dp"
            android:textColor="@color/k_subtle"
            android:textSize="11sp"
            tools:text="14:32" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
