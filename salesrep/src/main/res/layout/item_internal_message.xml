<?xml version="1.0" encoding="utf-8"?>
<!-- One internal chat message (SalesChatBubble, html = false): own on the right in blue, the
     colleague's on the left in white with a k_line border; sender name (colleague only), body and
     the time sit inside the bubble, which keeps 48dp free on the opposite side. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:id="@+id/bubble_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="48dp"
        android:background="@drawable/bg_k_msg_bubble_mine"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/text_sender_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/k_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Amra Hodžić" />

        <TextView
            android:id="@+id/text_message_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/k_white"
            android:textSize="14sp"
            tools:text="Vidimo se sutra na sastanku u 10h." />

        <TextView
            android:id="@+id/text_message_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/k_msg_time_mine"
            android:textSize="11sp"
            tools:text="14:32" />
    </LinearLayout>

</FrameLayout>
