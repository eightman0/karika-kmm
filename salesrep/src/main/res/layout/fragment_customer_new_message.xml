<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/karika_gray20"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layout_compose_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/karika_white"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_message_field_default"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/customer_message_subject_label"
                android:textColor="@color/karika_gray6"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/customer_message_subject_hint"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/karika_gray2"
                android:textColorHint="@color/karika_gray7"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/recipient_field_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_message_field_default"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/customer_message_recipient_label"
                    android:textColor="@color/karika_gray6"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edit_customer_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/customer_message_recipient_hint"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="@color/karika_gray2"
                    android:textColorHint="@color/karika_gray7"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/button_clear_customer"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/customer_message_remove_recipient_cd"
                    android:src="@drawable/ic_cancel_circle"
                    android:visibility="gone"
                    app:tint="@color/karika_gray6" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_customers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_message_dropdown_results"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/karika_gray9" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/karika_white"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_message_input_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <EditText
                android:id="@+id/edit_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/customer_message_input_hint"
                android:inputType="textMultiLine"
                android:maxLines="5"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="@color/karika_gray2"
                android:textColorHint="@color/karika_gray7"
                android:textSize="14sp" />

            <FrameLayout
                android:id="@+id/button_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_message_send_inactive"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/customer_message_send_cd"
                    android:src="@drawable/ic_send_receipt"
                    app:tint="@color/karika_white" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
