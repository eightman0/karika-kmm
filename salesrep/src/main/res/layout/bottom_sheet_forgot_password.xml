<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors composeApp's ForgotPasswordSheet (blue supplier variant): handle, lock icon tile,
     big title, muted description, gray email field and Zatvori / Potvrdi side by side. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_k_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_k_sheet_handle" />

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_k_shell_circle_accent_soft">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_k_shell_lock"
            app:tint="@color/k_accent" />
    </FrameLayout>

    <TextView
        android:id="@+id/text_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/login_forgot_password"
        android:textColor="@color/k_ink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="4sp"
        android:text="@string/forgot_password_description"
        android:textColor="@color/k_muted"
        android:textSize="14sp" />

    <TextView
        style="@style/K.Text.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="@string/login_email_label" />

    <EditText
        android:id="@+id/edit_forgot_email"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_k_shell_field_filled"
        android:drawableStart="@drawable/ic_k_shell_mail"
        android:drawablePadding="10dp"
        android:drawableTint="@color/k_muted"
        android:hint="@string/forgot_password_email_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:textColor="@color/k_ink"
        android:textColorHint="@color/k_subtle"
        android:textCursorDrawable="@null"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/button_close"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_k_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/forgot_password_close"
                android:textColor="@color/k_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/button_confirm"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_k_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:id="@+id/text_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/forgot_password_confirm"
                android:textColor="@color/k_white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
