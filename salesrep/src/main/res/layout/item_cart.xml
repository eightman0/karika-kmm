<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/k_white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/k_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardBackgroundColor="@color/k_field"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/image_product"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Name + remove -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:textColor="@color/k_ink"
                    android:textSize="14sp"
                    tools:text="Artikal XY sa dužim nazivom" />

                <FrameLayout
                    android:id="@+id/button_remove"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_k_ord_circle_ripple"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/action_delete"
                        android:src="@drawable/ic_k_ord_trash"
                        app:tint="@color/k_subtle" />
                </FrameLayout>
            </LinearLayout>

            <!-- SKU + read-only discount pills -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_sku"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_k_pill_field"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:textColor="@color/k_muted"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="#SKU-12345"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/text_discount_readonly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_k_pill_accent_soft"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:textColor="@color/k_accent"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Rabat: 10%"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Price + stepper -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_vpc_strike"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="@color/k_subtle"
                        android:textSize="11.5sp"
                        android:visibility="gone"
                        tools:text="30,00 KM"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/text_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="@color/k_ink"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="25,00 KM" />
                </LinearLayout>

                <!-- Blue "− n +" stepper: pill (50%) with 30dp circles, as in composeApp's CartItemRow -->
                <LinearLayout
                    android:id="@+id/layout_stepper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_k_ord_stepper"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <ImageView
                        android:id="@+id/button_minus"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_k_ord_step_circle"
                        android:contentDescription="@string/catalog_decrease_cd"
                        android:padding="7dp"
                        android:src="@drawable/ic_k_ord_minus"
                        app:tint="@color/k_accent" />

                    <EditText
                        android:id="@+id/edit_qty"
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:background="@null"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:importantForAutofill="no"
                        android:includeFontPadding="false"
                        android:inputType="number"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:textColor="@color/k_ink"
                        android:textSize="15sp"
                        tools:text="2" />

                    <ImageView
                        android:id="@+id/button_plus"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_k_ord_step_plus"
                        android:contentDescription="@string/catalog_increase_cd"
                        android:padding="7dp"
                        android:src="@drawable/ic_k_ord_plus"
                        app:tint="@color/k_white" />
                </LinearLayout>
            </LinearLayout>

            <!-- Editable discount -->
            <LinearLayout
                android:id="@+id/layout_discount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_k_ord_field_10"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/cart_discount_label"
                    android:textColor="@color/k_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_k_ord_white_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">

                    <EditText
                        android:id="@+id/edit_discount"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="end"
                        android:inputType="number"
                        android:maxLines="1"
                        android:padding="0dp"
                        android:textColor="@color/k_ink"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="10" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/discount_form_percent_suffix"
                        android:textColor="@color/k_muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
