<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_cart_item_card"
    android:clipToOutline="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_catalog_image_box">

            <ImageView
                android:id="@+id/image_product"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/karika_gray2"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Artikal XY sa dužim nazivom" />

            <TextView
                android:id="@+id/text_sku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/karika_gray6"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="#SKU-12345"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_vpc_strike"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/karika_gray6"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="30,00 KM"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/text_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/karika_blue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="25,00 KM" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/button_remove"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_cart_delete_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/action_delete"
                android:src="@drawable/ic_delete"
                app:tint="@color/karika_red" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="1dp"
        android:layout_marginBottom="1dp"
        android:background="@drawable/bg_catalog_product_footer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cart_quantity_label"
            android:textColor="@color/karika_gray6"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layout_stepper"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_catalog_stepper_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/button_minus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_catalog_stepper_button"
                android:contentDescription="@string/catalog_decrease_cd"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/karika_gray2"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_qty"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="center"
                android:inputType="number"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/karika_gray2"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="2" />

            <ImageView
                android:id="@+id/button_plus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_catalog_stepper_button"
                android:contentDescription="@string/catalog_increase_cd"
                android:padding="9dp"
                android:src="@drawable/ic_add_plus"
                app:tint="@color/karika_gray2" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/layout_discount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_catalog_stepper_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/cart_discount_label"
                android:textColor="@color/karika_gray6"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edit_discount"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="end"
                android:inputType="number"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/karika_gray2"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="10" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/discount_form_percent_suffix"
                android:textColor="@color/karika_gray6"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_discount_readonly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/karika_gray6"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Rabat: 10%" />
    </LinearLayout>

</LinearLayout>
