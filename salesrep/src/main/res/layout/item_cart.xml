<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    android:background="@color/karika_white"
    android:elevation="1dp"
    android:padding="14dp">

    <TextView
        android:id="@+id/text_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/karika_gray2"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/button_remove"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Artikal XY sa dužim nazivom" />

    <ImageButton
        android:id="@+id/button_remove"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_delete"
        android:src="@drawable/ic_delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/karika_error" />

    <TextView
        android:id="@+id/text_sku"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/karika_gray6"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_name"
        tools:text="SKU-12345 · 12,50 KM" />

    <LinearLayout
        android:id="@+id/layout_stepper"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:background="@color/karika_gray20"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_sku">

        <ImageButton
            android:id="@+id/button_minus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_delete"
            android:src="@drawable/ic_remove"
            app:tint="@color/karika_gray6" />

        <TextView
            android:id="@+id/text_qty"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/karika_gray2"
            android:textSize="14sp"
            tools:text="2" />

        <ImageButton
            android:id="@+id/button_plus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/catalog_add"
            android:src="@drawable/ic_add"
            app:tint="@color/karika_blue" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_discount"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:hint="@string/cart_discount_hint"
        app:layout_constraintBottom_toBottomOf="@id/layout_stepper"
        app:layout_constraintStart_toEndOf="@id/layout_stepper"
        app:layout_constraintTop_toTopOf="@id/layout_stepper">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_discount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/text_row_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/karika_gray2"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/layout_stepper"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/layout_stepper"
        tools:text="25,00 KM" />

</androidx.constraintlayout.widget.ConstraintLayout>
