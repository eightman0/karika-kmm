<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_k_card_14"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layout_product_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="horizontal"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp">

            <ImageView
                android:id="@+id/image_product"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_k_ord_image_box"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <FrameLayout
                android:id="@+id/badge_in_cart"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="@drawable/bg_k_ord_check_badge"
                android:visibility="gone">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="4dp"
                    android:src="@drawable/ic_k_ord_check"
                    app:tint="@color/k_white" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_category"
                style="@style/K.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/k_muted"
                android:textSize="11.5sp"
                android:visibility="gone"
                tools:text="Kategorija"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/text_name"
                style="@style/K.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textSize="14sp"
                tools:text="Artikal XY sa dužim nazivom" />

            <TextView
                android:id="@+id/text_sku"
                style="@style/K.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="@color/k_subtle"
                android:textSize="11.5sp"
                android:visibility="gone"
                tools:text="#SKU-12345"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_price"
                    style="@style/K.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="12,50 KM" />

                <TextView
                    android:id="@+id/text_out_of_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_k_pill_red_soft"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="@string/catalog_out_of_stock"
                    android:textColor="@color/k_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/k_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/layout_stepper"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_k_ord_stepper"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/button_minus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_k_ord_step_circle"
                android:contentDescription="@string/catalog_decrease_cd"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="−"
                android:textColor="@color/k_accent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_qty"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:inputType="number"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/k_ink"
                android:textSize="15sp"
                tools:text="1" />

            <ImageView
                android:id="@+id/button_plus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_k_ord_step_plus"
                android:contentDescription="@string/catalog_increase_cd"
                android:padding="8dp"
                android:src="@drawable/ic_k_ord_plus"
                app:tint="@color/k_white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/button_add"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_k_square_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_add"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_k_ord_cart_add"
                app:tint="@color/k_white" />

            <TextView
                android:id="@+id/text_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/catalog_add"
                android:textColor="@color/k_white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
