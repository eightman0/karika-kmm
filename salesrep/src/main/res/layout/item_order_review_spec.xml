<?xml version="1.0" encoding="utf-8"?>
<!-- One order line - mirrors SpecificationItem in composeApp's SalesOrderReviewView.kt: name,
     "Rabat"/"Provizija" pills, "Izmijeni", then the prices and quantity as key/value rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_k_card"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_name"
                style="@style/K.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="4sp"
                android:maxLines="2"
                android:textSize="14sp"
                tools:text="Artikal XY sa dužim nazivom" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_discount_pill"
                    style="@style/K.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_k_pill_accent_soft"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:textColor="@color/k_accent"
                    android:textSize="11sp"
                    tools:text="Rabat 5%" />

                <TextView
                    android:id="@+id/text_commission_pill"
                    style="@style/K.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_k_pill_field"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:textColor="@color/k_muted"
                    android:textSize="11sp"
                    tools:text="Provizija 3%" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/button_edit"
            style="@style/K.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_k_cart2_edit_link"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:text="@string/k_cart2_spec_edit"
            android:textColor="@color/k_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/k_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="13dp">

        <TextView
            style="@style/K.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/k_cart2_spec_price"
            android:textColor="@color/k_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_price"
            style="@style/K.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="2"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="0,00 KM" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="13dp">

        <TextView
            style="@style/K.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/k_cart2_spec_qty"
            android:textColor="@color/k_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_qty"
            style="@style/K.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="2"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="0,00 KM" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="13dp">

        <TextView
            style="@style/K.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/k_cart2_spec_total_vpc"
            android:textColor="@color/k_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_total_vpc"
            style="@style/K.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="2"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="0,00 KM" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="13dp">

        <TextView
            style="@style/K.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/k_cart2_spec_total_with_pdv"
            android:textColor="@color/k_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_total_with_pdv"
            style="@style/K.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="2"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="0,00 KM" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="13dp">

        <TextView
            style="@style/K.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/k_cart2_spec_commission"
            android:textColor="@color/k_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_commission"
            style="@style/K.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="2"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="0,00 KM" />
    </LinearLayout>

</LinearLayout>
