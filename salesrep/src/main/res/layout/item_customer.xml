<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:checkable="false"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/karika_white"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/karika_gray9"
    app:strokeWidth="1dp">

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_customer_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/karika_gray2"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Ada Lovelace" />

            <TextView
                android:id="@+id/text_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:background="@drawable/bg_customer_badge_active"
                tools:text="AKTIVAN"
                tools:textColor="@color/karika_green3" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="16dp" />

        <LinearLayout
            android:id="@+id/row_company"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_info_chip"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_storefront"
                app:tint="@color/karika_gray6" />

            <TextView
                android:id="@+id/text_company"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/karika_gray6"
                android:textSize="13sp"
                tools:text="Ada d.o.o." />
        </LinearLayout>

        <Space
            android:id="@+id/spacer_company"
            android:layout_width="1dp"
            android:layout_height="8dp" />

        <LinearLayout
            android:id="@+id/row_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_info_chip"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_email"
                app:tint="@color/karika_gray6" />

            <TextView
                android:id="@+id/text_email"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/karika_gray6"
                android:textSize="13sp"
                tools:text="ada@karika.ba" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_customer_card_footer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/reps_avatar_container"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/text_reps_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/customers_reps_label"
                android:textColor="@color/karika_gray7"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_unassigned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/customers_reps_unassigned"
                android:textColor="@color/karika_gray7"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/button_order"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_order_button_active"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shopping_cart"
                app:tint="@color/karika_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/customers_order_for"
                android:textColor="@color/karika_white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
