<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors composeApp's LoginView (supplier / blue variant): white header with rounded bottom
     holding the logo and "Prijava" + "Komercijalista" pill, the form in a white card, and the primary
     button in a white bottom panel. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_k_shell_login_root"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <!-- White header: Wi-Fi settings, logo, title with the account type -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/content_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_k_header"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <ImageView
                        android:id="@+id/button_wifi_settings"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_k_circle_button"
                        android:contentDescription="@string/wifi_settings_title"
                        android:padding="11dp"
                        android:src="@drawable/ic_k_shell_wifi"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/k_accent" />

                    <ImageView
                        android:id="@+id/image_logo"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="22dp"
                        android:contentDescription="@string/app_name"
                        android:scaleType="fitStart"
                        android:src="@drawable/ic_primary_logo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/button_wifi_settings" />

                    <TextView
                        android:id="@+id/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/login_title"
                        android:textColor="@color/k_ink"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/image_logo" />

                    <TextView
                        android:id="@+id/text_k_shell_account_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_k_pill_accent_soft"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/k_shell_login_account_type"
                        android:textColor="@color/k_accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/text_title"
                        app:layout_constraintStart_toEndOf="@id/text_title"
                        app:layout_constraintTop_toTopOf="@id/text_title" />

                    <TextView
                        android:id="@+id/text_k_shell_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4sp"
                        android:text="@string/k_shell_login_subtitle"
                        android:textColor="@color/k_muted"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/text_title" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Form card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_k_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/label_email"
                        style="@style/K.Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/login_email_label" />

                    <EditText
                        android:id="@+id/edit_email"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_k_shell_field_filled"
                        android:drawableStart="@drawable/ic_k_shell_mail"
                        android:drawablePadding="10dp"
                        android:drawableTint="@color/k_muted"
                        android:hint="@string/login_email_label"
                        android:importantForAutofill="no"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/k_ink"
                        android:textColorHint="@color/k_subtle"
                        android:textCursorDrawable="@null"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/text_email_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/k_red"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="Unesite valjanu email adresu."
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/label_password"
                        style="@style/K.Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/login_password_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_k_shell_field_filled"
                        android:hint="@string/login_password_label"
                        app:boxBackgroundMode="none"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/k_shell_icon_toggle"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/ic_k_shell_lock"
                        app:startIconTint="@color/k_muted">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_password"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:gravity="center_vertical"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:paddingStart="0dp"
                            android:paddingTop="0dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="0dp"
                            android:textColor="@color/k_ink"
                            android:textColorHint="@color/k_subtle"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/layout_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_remember_me"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/login_remember_me"
                            android:textColor="@color/k_ink"
                            android:textSize="14sp"
                            app:thumbTint="@color/k_white"
                            app:trackDecorationTint="@android:color/transparent"
                            app:trackTint="@color/k_shell_switch_track" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/text_forgot_password"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_k_shell_text_button"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="4dp"
                            android:text="@string/login_forgot_password"
                            android:textColor="@color/k_accent"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_k_pill_red_soft"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:textColor="@color/k_red"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Greška"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Bottom panel (KBottomPanel) with the primary action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_k_shell_bottom_panel"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:id="@+id/layout_button"
                android:layout_width="match_parent"
                android:layout_height="52dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_login"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/login_button"
                    android:textAllCaps="false"
                    android:textColor="@color/k_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/k_shell_button_primary_tint"
                    app:cornerRadius="14dp" />

                <ProgressBar
                    android:id="@+id/progress_login"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:elevation="4dp"
                    android:indeterminateTint="@color/k_white"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
