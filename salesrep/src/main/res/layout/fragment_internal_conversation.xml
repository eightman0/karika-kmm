<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/k_page"
    android:orientation="vertical">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp" />

    <!-- Composer: white panel with rounded top, pill k_field input and the blue "Pošalji" button (SalesChatInput). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_k_msg_composer"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edit_message"
                style="@style/K.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_k_msg_composer_input"
                android:gravity="center_vertical"
                android:hint="@string/internal_message_input_hint"
                android:inputType="textMultiLine"
                android:maxLines="5"
                android:minHeight="44dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="11dp"
                android:textColor="@color/k_ink"
                android:textColorHint="@color/k_subtle"
                android:textCursorDrawable="@drawable/bg_k_msg_cursor"
                android:textSize="15sp" />

            <!-- KPrimaryButton "Pošalji": 44dp, 14dp corners, send icon + text; 40% blue when disabled. -->
            <LinearLayout
                android:id="@+id/button_send"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_k_button_primary"
                android:clickable="true"
                android:contentDescription="@string/k_msg_send"
                android:enabled="false"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_k_msg_send" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/k_msg_send"
                    android:textColor="@color/k_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
