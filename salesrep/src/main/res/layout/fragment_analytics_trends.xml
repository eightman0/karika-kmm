<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/karika_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <include
            android:id="@+id/filter_bar"
            layout="@layout/layout_analytics_filter_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Prihod -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_stat_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/analytics_revenue_chart_title"
                    android:textColor="@color/karika_gray2"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analytics_revenue_chart_subtitle"
                    android:textColor="@color/karika_gray6"
                    android:textSize="12sp" />

            </LinearLayout>

            <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
                android:id="@+id/chart_revenue"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                app:chartStyle="@style/AnalyticsTrendsLineChartStyle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analytics_total_label"
                        android:textColor="@color/karika_gray6"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/text_revenue_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/karika_gray2"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="12.345,00 KM" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analytics_peak_label"
                        android:textColor="@color/karika_gray6"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/text_revenue_peak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/karika_gray2"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="2.100,00 KM" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analytics_growth_label"
                        android:textColor="@color/karika_gray6"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/text_revenue_growth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="+14,2%"
                        tools:textColor="@color/karika_green3" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Narudžbe -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_stat_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/analytics_orders_chart_title"
                    android:textColor="@color/karika_gray2"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/analytics_total_label"
                    android:textColor="@color/karika_gray6"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/text_orders_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/karika_gray2"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="128" />

            </LinearLayout>

            <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
                android:id="@+id/chart_orders"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                app:chartStyle="@style/AnalyticsTrendsColumnChartStyle" />

        </LinearLayout>

        <!-- Aktivni/novi kupci -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/text_active_customers_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/karika_gray2"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="42" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/analytics_active_customers"
                    android:textColor="@color/karika_gray6"
                    android:textSize="12sp" />

                <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
                    android:id="@+id/chart_active_customers"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="8dp"
                    app:chartStyle="@style/AnalyticsTrendsMiniLineChartStyle" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/text_new_customers_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/karika_gray2"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/analytics_new_customers"
                    android:textColor="@color/karika_gray6"
                    android:textSize="12sp" />

                <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
                    android:id="@+id/chart_new_customers"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="8dp"
                    app:chartStyle="@style/AnalyticsTrendsMiniLineChartStyle" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
