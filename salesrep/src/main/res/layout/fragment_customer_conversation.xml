<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/karika_gray20"
    android:orientation="vertical">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/karika_white"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layout_pending_attachment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_pending_attachment_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/icon_attachment_type"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_attachment"
                app:tint="@color/karika_blue" />

            <TextView
                android:id="@+id/text_attachment_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/karika_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="dokument.pdf" />

            <ImageView
                android:id="@+id/button_remove_attachment"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/message_remove_attachment_cd"
                android:src="@drawable/ic_cancel_circle"
                app:tint="@color/karika_gray6" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_message_input_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <FrameLayout
                android:id="@+id/button_attach"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icon_attach"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/message_attach_cd"
                    android:src="@drawable/ic_attachment"
                    app:tint="@color/karika_gray6" />
            </FrameLayout>

            <EditText
                android:id="@+id/edit_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/customer_message_input_hint"
                android:inputType="textMultiLine"
                android:maxLines="5"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:textColor="@color/karika_gray2"
                android:textColorHint="@color/karika_gray7"
                android:textSize="14sp" />

            <FrameLayout
                android:id="@+id/button_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_message_send_inactive"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/customer_message_send_cd"
                    android:src="@drawable/ic_send_receipt"
                    app:tint="@color/karika_white" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
