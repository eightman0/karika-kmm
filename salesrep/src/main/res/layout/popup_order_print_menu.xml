<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_menu_white"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/action_print_order"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_pill_outline_blue"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:text="@string/order_detail_print_order"
        android:textColor="@color/karika_blue"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Space
        android:layout_width="1dp"
        android:layout_height="8dp" />

    <TextView
        android:id="@+id/action_print_estimate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_pill_outline_blue"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:text="@string/order_detail_print_estimate"
        android:textColor="@color/karika_blue"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Space
        android:layout_width="1dp"
        android:layout_height="8dp" />

    <TextView
        android:id="@+id/action_send_estimate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_pill_filled_blue"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:text="@string/order_detail_send_estimate"
        android:textColor="@color/karika_white"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
