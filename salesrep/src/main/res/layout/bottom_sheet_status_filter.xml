<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_k_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_k_sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/customers_status_sheet_title"
        android:textColor="@color/k_ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/option_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_k_cust_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="50dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp"
        android:tag="@null">

        <TextView
            android:id="@+id/label_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/customers_status_all_sheet"
            android:textColor="@color/k_ink"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/check_all"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_k_cust_check"
            android:visibility="gone"
            app:tint="@color/k_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/option_active"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_k_cust_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="50dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp"
        android:tag="active">

        <TextView
            android:id="@+id/label_active"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/customers_filter_active"
            android:textColor="@color/k_ink"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/check_active"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_k_cust_check"
            android:visibility="gone"
            app:tint="@color/k_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/option_pending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_k_cust_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="50dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp"
        android:tag="pending">

        <TextView
            android:id="@+id/label_pending"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/customers_filter_pending"
            android:textColor="@color/k_ink"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/check_pending"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_k_cust_check"
            android:visibility="gone"
            app:tint="@color/k_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/option_rejected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_k_cust_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="50dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp"
        android:tag="rejected">

        <TextView
            android:id="@+id/label_rejected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/customers_filter_rejected"
            android:textColor="@color/k_ink"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/check_rejected"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_k_cust_check"
            android:visibility="gone"
            app:tint="@color/k_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/option_revoked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_k_cust_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="50dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp"
        android:tag="revoked">

        <TextView
            android:id="@+id/label_revoked"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/customers_filter_revoked"
            android:textColor="@color/k_ink"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/check_revoked"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_k_cust_check"
            android:visibility="gone"
            app:tint="@color/k_accent" />
    </LinearLayout>

</LinearLayout>
