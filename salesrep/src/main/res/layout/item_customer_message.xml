<?xml version="1.0" encoding="utf-8"?>
<!-- One chat message (SalesChatBubble): own on the right in blue, the other side's on the left in
     white with a k_line border. Sender name (other side only), attachments, body and the time all
     sit inside the bubble; the bubble keeps 48dp free on the opposite side. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:id="@+id/bubble_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="48dp"
        android:background="@drawable/bg_k_msg_bubble_mine"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/text_sender_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/k_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Administrator" />

        <ImageView
            android:id="@+id/image_attachment"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_k_msg_image_12"
            android:clickable="true"
            android:contentDescription="@string/message_attachment_image_cd"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/row_attachment_pdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:background="@drawable/bg_k_msg_pdf_mine"
            android:clickable="true"
            android:contentDescription="@string/message_attachment_pdf_cd"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/icon_attachment_pdf"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_pdf"
                app:tint="@color/k_white" />

            <TextView
                android:id="@+id/text_attachment_pdf_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/k_white"
                android:textSize="12sp"
                tools:text="dokument.pdf" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_message_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/k_white"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Poštovani, hvala na upitu."
            tools:visibility="visible" />

        <TextView
            android:id="@+id/text_message_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/k_msg_time_mine"
            android:textSize="11sp"
            tools:text="2026-08-09 14:32:00" />
    </LinearLayout>

</FrameLayout>
