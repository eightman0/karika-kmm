<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:id="@+id/bubble_column"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.82">

        <TextView
            android:id="@+id/text_sender_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="2dp"
            android:textColor="@color/karika_blue"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Ja" />

        <TextView
            android:id="@+id/text_message_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="@drawable/bg_bubble_mine"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="@color/karika_white"
            android:textSize="14sp"
            tools:text="Poštovani, hvala na upitu." />

        <TextView
            android:id="@+id/text_message_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textColor="@color/karika_gray7"
            android:textSize="10sp"
            tools:text="2026-08-09 14:32:00" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
