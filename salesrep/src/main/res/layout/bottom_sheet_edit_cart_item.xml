<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sheet_drag_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/review_edit_item_title"
        android:textColor="@color/karika_gray2"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/karika_gray9" />

    <TextView
        android:id="@+id/text_item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/karika_gray2"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Artikal XY" />

    <LinearLayout
        android:id="@+id/layout_discount_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/review_edit_item_discount_label"
            android:textColor="@color/karika_gray2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Space android:layout_width="1dp" android:layout_height="6dp" />

        <EditText
            android:id="@+id/edit_discount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_form_field"
            android:inputType="number"
            android:maxLength="3"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textColor="@color/karika_gray2"
            android:textSize="14sp"
            tools:text="10" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_discount_readonly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/karika_gray6"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Rabat: 10%" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/review_edit_item_qty_label"
        android:textColor="@color/karika_gray2"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Space android:layout_width="1dp" android:layout_height="6dp" />

    <EditText
        android:id="@+id/edit_qty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_form_field"
        android:inputType="number"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textColor="@color/karika_gray2"
        android:textSize="14sp"
        tools:text="2" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/karika_gray9" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/button_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline_blue"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/review_edit_item_cancel"
                android:textColor="@color/karika_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/button_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_pill_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/review_edit_item_confirm"
                android:textColor="@color/karika_white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
