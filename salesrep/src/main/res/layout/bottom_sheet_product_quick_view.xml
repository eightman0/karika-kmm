<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_drag_handle" />

    <Space
        android:layout_width="1dp"
        android:layout_height="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/catalog_quick_view_title"
            android:textColor="@color/karika_gray2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/button_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_sheet_close_button"
            android:clickable="true"
            android:contentDescription="@string/customers_sheet_close_cd"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_cancel"
            app:tint="@color/karika_gray2" />
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="16dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_catalog_image_box">

        <ImageView
            android:id="@+id/image_product"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_stock_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:background="@drawable/bg_customer_badge_active"
            tools:text="NA ZALIHI"
            tools:textColor="@color/karika_green3" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/text_available_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/karika_gray6"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Dostupno: 0" />
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="10dp" />

    <TextView
        android:id="@+id/text_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/karika_gray2"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="brasno klas" />

    <Space
        android:layout_width="1dp"
        android:layout_height="6dp" />

    <TextView
        android:id="@+id/text_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/karika_gray6"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Kategorija: PREHRAMBENI PROIZVODI &gt; BRAŠNO I PROIZVODI OD BRAŠNA &gt; BRAŠNO"
        tools:visibility="visible" />

    <Space
        android:layout_width="1dp"
        android:layout_height="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/catalog_quick_view_sku_label"
                android:textColor="@color/karika_gray6"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_sku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/karika_gray2"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="K-273-00000006" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/catalog_quick_view_price_label"
                android:textColor="@color/karika_gray6"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/karika_gray2"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="3,00 KM" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/karika_gray9" />

    <Space
        android:layout_width="1dp"
        android:layout_height="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/catalog_quick_view_description_label"
        android:textColor="@color/karika_gray6"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/karika_gray2"
        android:textSize="14sp"
        tools:text="Opis nije dostupan." />

    <Space
        android:layout_width="1dp"
        android:layout_height="8dp" />

</LinearLayout>
