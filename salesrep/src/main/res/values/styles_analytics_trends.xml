<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Vico CartesianChartView styles for the "Trendovi prodaje" screen. The `layers` /
         `showBottomAxis` / `showStartAxis` attributes only exist on the CartesianChartStyle
         styleable, which the view only reads from a style resource referenced via `chartStyle`
         (not from attributes set directly on the view tag), so each chart needs one of these. -->

    <style name="AnalyticsTrendsLineChartStyle">
        <item name="layers">line</item>
        <item name="showBottomAxis">true</item>
        <item name="showStartAxis">true</item>
    </style>

    <style name="AnalyticsTrendsColumnChartStyle">
        <item name="layers">column</item>
        <item name="showBottomAxis">true</item>
        <item name="showStartAxis">true</item>
    </style>

    <!-- Small trend-shape-only charts (active/new customers mini cards) - no axis labels. -->
    <style name="AnalyticsTrendsMiniLineChartStyle">
        <item name="layers">line</item>
        <item name="showBottomAxis">false</item>
        <item name="showStartAxis">false</item>
    </style>
</resources>
