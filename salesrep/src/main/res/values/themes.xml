<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SalesRep" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/karika_blue</item>
        <item name="colorOnPrimary">@color/karika_white</item>
        <item name="android:statusBarColor">@color/karika_white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.SalesRep.NoDrawerToggle" parent="Theme.SalesRep" />

    <style name="BottomSheetOption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:textColor">@color/karika_gray2</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
