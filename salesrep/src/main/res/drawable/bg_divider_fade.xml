<?xml version="1.0" encoding="utf-8"?>
<!-- Approximates composeApp's 4-stop horizontal fade (transparent-gray9-gray9-transparent) on
     the CustomerCard header/footer divider - a 3-stop gradient reads the same since the solid
     midsection is what the eye picks up. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@android:color/transparent"
        android:centerColor="@color/karika_gray9"
        android:endColor="@android:color/transparent" />
</shape>
