<?xml version="1.0" encoding="utf-8"?>
<!-- White expanded body inside the amber card: amber hairline on top, bottom corners match the card -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/k_ord_amber_line" />
            <corners android:topLeftRadius="0dp" android:topRightRadius="0dp" android:bottomLeftRadius="13dp" android:bottomRightRadius="13dp" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/k_white" />
            <corners android:topLeftRadius="0dp" android:topRightRadius="0dp" android:bottomLeftRadius="13dp" android:bottomRightRadius="13dp" />
        </shape>
    </item>
</layer-list>
